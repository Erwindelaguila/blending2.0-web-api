{
  "ReverseProxy": {
    "Routes": {
      "functionA-route": {
        "ClusterId": "functionA",
        "Match": {
          "Path": "/api/functionA/{**catch-all}"
        }
      },
      "functionB-route": {
        "ClusterId": "functionB",
        "Match": {
          "Path": "/api/functionB/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "functionA": {
        "Destinations": {
          "dest1": {
            "Address": "https://localhost:7071/"
          }
        },
        "HttpClient": {
          "DangerousAcceptAnyServerCertificate": true
        }
      },
      "functionB": {
        "Destinations": {
          "dest1": {
            "Address": "https://localhost:7072/"
          }
        },
        "HttpClient": {
          "DangerousAcceptAnyServerCertificate": true
        }
      }
    }
  }
}