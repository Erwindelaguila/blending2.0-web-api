<?xml version="1.0" encoding="UTF-8"?>
<!-- 
Azure APIM Policies - Equivalente exacto al ApimSimulatorMiddleware
Coloca esto en las políticas de APIM en Azure Portal
-->
<policies>
    <inbound>
        <!-- Validar JWT - exactamente como nuestro simulator -->
        <validate-jwt header-name="Authorization" failed-validation-httpcode="401" failed-validation-error-message="Unauthorized - JWT token required">
            <openid-config url="https://login.microsoftonline.com/{tenant-id}/v2.0/.well-known/openid_configuration" />
            <required-claims>
                <claim name="aud" match="any">
                    <value>{your-client-id}</value>
                </claim>
            </required-claims>
        </validate-jwt>
        
        <!-- Inyectar headers X-User-* - exactamente como nuestro simulator -->
        <set-header name="X-User-Id" exists-action="override">
            <value>@(context.Request.Headers.GetValueOrDefault("Authorization","")
                .Replace("Bearer ","")
                .AsJwt()?.Claims?.FirstOrDefault(x => x.Type == "oid")?.Value ?? "unknown")</value>
        </set-header>
        
        <set-header name="X-User-Name" exists-action="override">
            <value>@(context.Request.Headers.GetValueOrDefault("Authorization","")
                .Replace("Bearer ","")
                .AsJwt()?.Claims?.FirstOrDefault(x => x.Type == "name")?.Value ?? "unknown")</value>
        </set-header>
        
        <set-header name="X-User-Email" exists-action="override">
            <value>@(context.Request.Headers.GetValueOrDefault("Authorization","")
                .Replace("Bearer ","")
                .AsJwt()?.Claims?.FirstOrDefault(x => x.Type == "email")?.Value ?? "unknown")</value>
        </set-header>
        
        <!-- Scopes del usuario - exactamente como nuestro simulator -->
        <set-header name="X-User-Scopes" exists-action="override">
            <value>@{
                var jwt = context.Request.Headers.GetValueOrDefault("Authorization","").Replace("Bearer ","").AsJwt();
                var scopes = jwt?.Claims?.Where(x => x.Type == "scp" || x.Type == "scope")?.FirstOrDefault()?.Value ?? "";
                return scopes;
            }</value>
        </set-header>
    </inbound>
    
    <backend>
        <forward-request />
    </backend>
    
    <outbound />
    
    <on-error />
</policies>
