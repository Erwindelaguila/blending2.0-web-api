## Ignore Visual Studio temporary files, build results, and files generated by popular Visual Studio add-ons

# Azure Functions local settings
local.settings.json

# User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates
*.DotSettings.user

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
builds/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Oo]ut/
[Ll]og/
[Ll]ogs/

# Visual Studio
.vs/
.vscode/
.idea/

# Logs
*.log

# NuGet Packages
*.nupkg
**/packages/*
!**/packages/build/
*.nuget.props
*.nuget.targets

# Microsoft Azure
csx/
*.build.csdef
ecf/
rcf/
PublishScripts/
*.azurePubxml

# Node.js / Frontend stuff
node_modules/
bower_components/

# Cache / temp
*.[Cc]ache
*.tmp
~$*
*~

# Backup & upgrade logs
_UpgradeReport_Files/
Backup*/
UpgradeLog*.XML
UpgradeLog*.htm

# SQL Server
*.mdf
*.ldf

# JetBrains / Rider
.idea/
*.sln.iml

# Python cache (en caso de usar scripts auxiliares)
__pycache__/
*.pyc

# Misc
.DS_Store
